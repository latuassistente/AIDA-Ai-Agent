generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  customers Customer[]
  projects  Project[]
  goals     Goal[]
  documents KnowledgeDocument[]
  approvals ApprovalRequest[]
  auditLogs AuditLog[]
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projects  Project[]
  @@index([tenantId, email])
  @@index([tenantId, phone])
}

model Project {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String
  name        String
  objective   String
  stage       String   @default("DISCOVERY")
  status      String   @default("ACTIVE")
  brain       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  goals       Goal[]
  @@index([tenantId, status])
  @@index([customerId])
}

model Goal {
  id              String   @id @default(cuid())
  tenantId        String
  projectId       String?
  objective       String
  successCriteria Json
  constraints     Json
  status          String   @default("DRAFT")
  riskLevel       String   @default("YELLOW")
  nextAction      String?
  deadline        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  steps           GoalStep[]
  approvals       ApprovalRequest[]
  @@index([tenantId, status])
  @@index([projectId])
}

model GoalStep {
  id          String   @id @default(cuid())
  goalId      String
  stepKey     String
  agentId     String
  objective   String
  status      String   @default("PENDING")
  dependsOn   Json
  result      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  @@unique([goalId, stepKey])
  @@index([goalId, status])
}

model KnowledgeDocument {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  sourceType  String
  sourceRef   String
  version     String
  status      String   @default("ACTIVE")
  effectiveFrom DateTime?
  effectiveUntil DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks      KnowledgeChunk[]
  @@index([tenantId, status])
  @@index([tenantId, sourceRef, version])
}

model KnowledgeChunk {
  id          String   @id @default(cuid())
  documentId  String
  chunkIndex  Int
  content     String
  metadata    Json?
  embedding   Json?
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model ApprovalRequest {
  id          String   @id @default(cuid())
  tenantId    String
  goalId      String
  action      String
  reason      String
  requestedBy String
  status      String   @default("PENDING")
  decidedBy   String?
  createdAt   DateTime @default(now())
  decidedAt   DateTime?
  expiresAt   DateTime?
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  @@index([tenantId, status])
  @@index([goalId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actor     String
  action    String
  decision  String
  target    String?
  details   Json?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
  @@index([tenantId, action])
}

model UnifiedMessage {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String?
  projectId   String?
  channel     String
  direction   String
  externalId  String?
  sender      String
  recipient   String
  text        String?
  receivedAt  DateTime
  metadata    Json?
  @@unique([tenantId, channel, externalId])
  @@index([tenantId, customerId, receivedAt])
  @@index([tenantId, projectId, receivedAt])
}
